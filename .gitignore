# ── 开发过程文档（仅 README 入库）──
/docs/
/discussion/
/research/
/SPEC.md
/RECEIPT.md
/tickets/

# ── 构建产物 ──
build/
build-*/
/cmake-build-*/
/compile_commands.json
*.o
*.a
*.so
*.d
*.gcda
*.gcno
*.profraw

# ── 运行时数据 ──
/runs/
/cassettes/
/logs/
*.log
# 只忽略运行/录像产物，别把 suites 里将来可能加的 jsonl fixture 一起吞掉
/runs/**/*.jsonl
/cassettes/**/*.jsonl
# 例外：suites 下将来若放 jsonl fixture，必须能入库
!suites/**/*.jsonl

# ── 测试与覆盖率 ──
/coverage/
/pwtest/
*.pcap
__pycache__/

# ── 本地媒体样本与复现产物 ──
*.mp4
*.h264
*.y4m

# ── benchmark 数据（scripts/bench.sh 的产出，只入库脚本）──
/bench/

# ── 前端 ──
/web/node_modules/
/web/dist/
.vite/

# ── 本地环境与编辑器 ──
.env
.env.local
*.local
.DS_Store
.vscode/
.idea/
