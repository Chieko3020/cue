{
  "suite": "m2-constraints",
  "version": 1,
  "note": "C06：manual_only默认real跳过，可用离线manual输入重判。AVC尺寸证据必须实际等于1920/1080。fec_ghost_frame保留历史ID，但只表示已完成帧的迟到分片重建尝试被e2e_frag_ghost_discarded守卫拒绝，不证明成功重组或重复播放；FEC恢复计数非零不是幽灵帧证据。离线来源由提供者声明，不替代真实浏览器/FEC现场验收。",
  "cases": [
    {
      "id": "avc-level-mismatch",
      "seed": 1,
      "manual_only": true,
      "fault": {
        "kind": "none"
      },
      "pipeline": {
        "transcode": true,
        "width": 1920,
        "height": 1080,
        "bitrate_kbps": 6000,
        "gop": 60,
        "preset": "veryfast"
      },
      "prompt": "下行按 1080p（1920x1080）转码。上行 VideoEncoder.configure() 直接抛错：coded area 2088960 exceeds maximum 414720 (AVC level 3.0)。定位原因并修复，使 1080p 能正常编码。",
      "expect": {
        "root_cause": "resolution_too_high",
        "evidence_candidates": [
          "encode_width==1920",
          "encode_height==1080"
        ],
        "allowed_actions": [
          "pipeline_set_param"
        ],
        "sla": {
          "usable_fps_min": 25
        }
      },
      "budget": {
        "max_turns": 6,
        "max_yuan": 0.1,
        "max_wall_s": 120
      }
    },
    {
      "id": "fec-ghost-frame",
      "seed": 1,
      "manual_only": true,
      "fault": {
        "kind": "drop",
        "params": {
          "inject_drop_pct": 5
        }
      },
      "pipeline": {
        "transcode": false
      },
      "prompt": "下行注入5%丢包并启用XOR-FEC。核对已完成帧的迟到分片是否尝试重建接收槽位并被守卫拒绝，引用e2e_frag_ghost_discarded的实际计数；不要把正常FEC恢复或守卫命中说成已成功重组/重复播放。",
      "expect": {
        "root_cause": "fec_ghost_frame",
        "evidence_candidates": [
          "e2e_frag_ghost_discarded>0"
        ],
        "allowed_actions": [
          "inject_fault",
          "pipeline_set_param"
        ],
        "sla": {
          "frame_completion_min": 0.95
        }
      },
      "budget": {
        "max_turns": 8,
        "max_yuan": 0.15,
        "max_wall_s": 180
      }
    }
  ]
}
