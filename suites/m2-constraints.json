{
  "suite": "m2-constraints",
  "version": 1,
  "note": "M2 的约束回归集：把 M0/M2 实测踩到的两个坑固化成可被 M4 评测引擎消费的 case。两者都只能人工复现（AVC level 由浏览器侧 configure 决定，FEC 幽灵帧不在 8 类根因枚举内），因此标 manual_only：real 模式跳过、不计入成功率分母。suite 字段必须全部被引擎认识——未知字段一律报错，避免『写错字段 → SLA 恒真 → 假绿灯』。evidence_candidates 只能引用 query_metrics 真实输出的字段（N-02）：曾经引用的 frames_no_data / frames_completed 在整个仓库里都不存在，证据层因此永远 0%。",
  "cases": [
    {
      "id": "avc-level-mismatch",
      "seed": 1,
      "manual_only": true,
      "fault": {
        "kind": "none"
      },
      "pipeline": {
        "transcode": false
      },
      "prompt": "上行 VideoEncoder.configure() 直接抛错：coded area 2088960 exceeds maximum 414720 (AVC level 3.0)。定位原因并修复，使 1080p 能正常编码。",
      "expect": {
        "root_cause": "resolution_too_high",
        "evidence_candidates": [
          "encode_width",
          "encode_height"
        ],
        "allowed_actions": [
          "pipeline_set_param"
        ],
        "sla": {
          "usable_fps_min": 25
        }
      },
      "budget": {
        "max_turns": 6,
        "max_yuan": 0.1,
        "max_wall_s": 120
      }
    },
    {
      "id": "fec-ghost-frame",
      "seed": 1,
      "manual_only": true,
      "fault": {
        "kind": "drop",
        "params": {
          "inject_drop_pct": 5
        }
      },
      "pipeline": {
        "transcode": false
      },
      "prompt": "下行注入 5% 丢包并启用 XOR-FEC。检查 probe 侧是否出现幽灵帧（FEC 冗余包或迟到分片为已完成的帧重建接收槽位），并给出根因。",
      "expect": {
        "root_cause": "fec_ghost_frame",
        "evidence_candidates": [
          "e2e_fec_recovered",
          "e2e_fec_ghost_discarded",
          "e2e_frag_ghost_discarded"
        ],
        "allowed_actions": [
          "inject_fault",
          "pipeline_set_param"
        ],
        "sla": {
          "frame_completion_min": 0.95
        }
      },
      "budget": {
        "max_turns": 8,
        "max_yuan": 0.15,
        "max_wall_s": 180
      }
    }
  ]
}
